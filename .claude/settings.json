{
  "permissions": {
    "allow": [
      "mcp__Composio_Docs_Drive__COMPOSIO_REMOTE_BASH_TOOL",
      "mcp__Composio_Docs_Drive__COMPOSIO_SEARCH_TOOLS",
      "mcp__Composio_Docs_Drive__COMPOSIO_GET_TOOL_SCHEMAS",
      "mcp__Composio_Docs_Drive__COMPOSIO_MULTI_EXECUTE_TOOL"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "CLAUDE_HOOKS_VIA_SETTINGS=1 python3 \"$CLAUDE_PROJECT_DIR/plugins/session-capture/hooks/remind.py\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "CLAUDE_HOOKS_VIA_SETTINGS=1 python3 \"$CLAUDE_PROJECT_DIR/plugins/session-capture/hooks/capture.py\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "CLAUDE_HOOKS_VIA_SETTINGS=1 python3 \"$CLAUDE_PROJECT_DIR/plugins/job-fetch/hooks/detect-job-url.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "CLAUDE_HOOKS_VIA_SETTINGS=1 python3 \"$CLAUDE_PROJECT_DIR/plugins/session-capture/hooks/flush.py\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "CLAUDE_HOOKS_VIA_SETTINGS=1 python3 \"$CLAUDE_PROJECT_DIR/plugins/session-capture/hooks/flush.py\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "CLAUDE_HOOKS_VIA_SETTINGS=1 python3 \"$CLAUDE_PROJECT_DIR/plugins/session-capture/hooks/flush.py\""
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "job-fetch@hbschlac": true,
    "session-capture@hbschlac": true
  },
  "extraKnownMarketplaces": {
    "hbschlac": {
      "source": {
        "source": "github",
        "repo": "hbschlac/hbschlac"
      }
    }
  }
}
